# 复制此文件为 .env 再填写真实值
# cp .env.example .env

# ─── 大模型 API(必填) ────────────────────────────────────
# 当前默认通道:OpenCode Go 套餐(OpenAI 兼容接口)
# key 在 https://opencode.ai/auth 拿;Zen 和 Go 是同一个 key
LLM_API_KEY=在这里填你的OPENCODE_GO_API_KEY
LLM_MODEL=deepseek-v4.1-flash
# 如需改端点(例如走代理),在这里填
# LLM_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
#
# 说明:
# - LLM_MODEL 也可填 deepseek-v4-flash / kimi-k2.6 / glm-5.3 等,见
#   `curl -s https://opencode.ai/zen/go/v1/models`
# - LLM_API_KEY 留空会自动退回下面的旧 MiniMax 通道(回滚用)
# - LLM_SESSION_HEADER / LLM_USER_AGENT 一般不用动(见 src/config.py 注释)

# ─── 旧通道:MinMax(留空 LLM_API_KEY 时才生效,用于回滚) ────
# MINMAX_API_KEY=
# MINMAX_GROUP_ID=
# MINMAX_MODEL=abab6.5s-chat
# MINMAX_ENDPOINT=https://api.minimax.chat/v1/text/chatcompletion_v2

# ─── 可选:路径覆盖 ────────────────────────────────────────
# WINDOWS_ROOT:数据文件根目录(materials/ + 常问问题.txt + 花名册 + 补交表)
# **默认就是 ~/ykt_questions,一般不用填这一行。**
# 注意:数据放 WSL 原生目录(~/)比放在 /mnt/c/... 下快得多,也避开了中文路径的坑。
# WINDOWS_ROOT=~/ykt_questions
# 非要指到 Windows 侧时(先确认补交记录已经合并过去,否则丢数据):
# WINDOWS_ROOT=/mnt/c/Users/YOUR_USERNAME/Downloads/ykt_questions

# ─── 可选:行为调参 ────────────────────────────────────────
# 下面注释里的数字是**代码里的默认值**,要改就取消注释再改。
# 前缀过滤:只有带此前缀的消息才视为学生转发,才会处理
# 可配置多个前缀(逗号分隔,覆盖全部默认变体)
# FORWARD_PREFIX=【转发学生提问】,【转发同学提问】
# FAQ_HIT_THRESHOLD=4.0
# RAG_TOP_K=7
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# LLM_TIMEOUT=20
# LLM_MAX_RETRIES=3
