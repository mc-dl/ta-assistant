# 复制此文件为 .env 再填写真实值
# cp .env.example .env

# ─── MinMax 大模型 API(必填) ─────────────────────────────
MINMAX_API_KEY=在这里填你的API_KEY
MINMAX_GROUP_ID=在这里填你的GROUP_ID
MINMAX_MODEL=abab6.5s-chat
# 如需改端点(例如走代理),在这里填
# MINMAX_ENDPOINT=https://api.minimax.chat/v1/text/chatcompletion_v2

# ─── 可选:路径覆盖 ────────────────────────────────────────
# WINDOWS_ROOT:数据文件根目录(Windows WSL 下用 /mnt/c/..., Linux/macOS 用 ~/)
# WSL 用户: WINDOWS_ROOT=/mnt/c/Users/YOUR_USERNAME/Downloads/ykt_questions
# Linux/macOS 用户: WINDOWS_ROOT=~/ykt_questions
# WINDOWS_ROOT=/mnt/c/Users/YOUR_USERNAME/Downloads/ykt_questions

# ─── 可选:行为调参 ────────────────────────────────────────
# 前缀过滤:只有带此前缀的消息才视为学生转发,才会处理
# 可配置多个前缀(逗号分隔,覆盖全部默认变体)
# FORWARD_PREFIX=【转发学生提问】,【转发同学提问】
# FAQ_HIT_THRESHOLD=4.0
# RAG_TOP_K=5
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# LLM_TIMEOUT=20
# LLM_MAX_RETRIES=3
